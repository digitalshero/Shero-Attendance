# Shero Attendance — frontend production environment template.
# Vite inlines this at BUILD time (not runtime) — set it before running `npm run build`.
#
# Relative path, not an absolute domain: the frontend and backend are served from the
# SAME Nginx host (see deploy/nginx/shero-attendance.conf), so "/api" resolves correctly
# regardless of which domain eventually points at this server — no need to know the
# final domain before building, and it avoids a cross-origin request entirely.
VITE_API_URL=/api
