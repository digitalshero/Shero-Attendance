# Shero Attendance — backend production environment template.
# Copy to /data/shero-attendance/backend/.env on the server (chmod 600, never committed).
# Every value below is a PLACEHOLDER — do not paste real secrets into this file in the repo.

# Dedicated Postgres database + role for Attendance only (never the shared dbadmin account).
POSTGRES_URL=postgresql://attendance_app:REPLACE_WITH_DEDICATED_PASSWORD@REPLACE_WITH_RDS_HOST:5432/shero_attendance

# Leave unset (SSL + certificate verification required) in production.
# Only ever set to "disable" for local dev against a non-TLS local Postgres.
# PGSSLMODE=disable

# REQUIRED in production (ignored if PGSSLMODE=disable): absolute path to the AWS RDS CA
# bundle on this server, used to verify the RDS server's TLS certificate. Download it from
# https://truststore.pki.rds.amazonaws.com/ap-south-1/ap-south-1-bundle.pem (ap-south-1 region)
# and place it outside the git-managed directory, e.g. /data/shero-attendance/certs/rds-ca.pem.
# The app refuses to start without this unless PGSSLMODE=disable is set.
DATABASE_SSL_CA_PATH=/data/shero-attendance/certs/rds-ca.pem

# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Backend listens on localhost only; Nginx reverse-proxies to it.
HOST=127.0.0.1
PORT=4800

# Production frontend origin(s) for CORS — set to the confirmed domain once known.
FRONTEND_URL=https://REPLACE_WITH_CONFIRMED_DOMAIN
